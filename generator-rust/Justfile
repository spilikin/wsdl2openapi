# display info about the project
info:
    just -l

# regenerate the module trees mounted by testproj
generate:
    rm -rf testproj/src/kon testproj/src/edge testproj/src/conn
    cargo run -- --file ../konnektor-6.0.1.json --output testproj/src/kon --naming naming-kon.json --module-root crate::kon
    cargo run -- --file ../konnektor-6.0.1.json --output testproj/src/conn --naming naming-kon.json --module-root crate::conn --select testproj/select-konnektor.json
    cargo run -- --file tests/fixtures/edge-cases/api.json --output testproj/src/edge --naming tests/fixtures/edge-cases/naming.json --module-root crate::edge

# rewrite the golden trees under tests/fixtures/*/expected
update-golden:
    UPDATE_GOLDEN=1 cargo test --test golden

test:
    cargo test
    cd testproj && cargo test

lint:
    cargo fmt --check
    cargo clippy --all-targets -- -D warnings
    cd testproj && cargo clippy --all-targets -- -D warnings
